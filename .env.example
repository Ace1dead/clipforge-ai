# Server
PORT=3001
NODE_ENV=development

# JWT - Change these in production!
JWT_SECRET=change-me-to-a-random-string
JWT_REFRESH_SECRET=change-me-to-another-random-string

# Admin - Your master key for premium access
ADMIN_KEY=change-me-to-your-admin-key

# Database
DB_PATH=./server/data/clipforge.db

# External APIs (optional - tools have graceful fallbacks)
PEXELS_API_KEY=
STREAMELEMENTS_TTS=true
